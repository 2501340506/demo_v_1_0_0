            24,
            321,
            336,
            344
          ],
          "font_px": 24
        },
        {
          "text": "山洪与泥石流不能混为一谈",
          "box": [
            24,
            362,
            312,
            385
          ],
          "font_px": 24
        },
        {
          "text": "以当地预案和现场指挥为准",
